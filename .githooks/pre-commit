#!/bin/sh
# Fleet-generic pre-commit gate: voice through the one central core, plus secret hygiene. Issue #33.
#
# opeff#1347 M2 / opeff#1361, opeff#1390 step 1: the markdown/config dash arm
# that used to be written inline here now runs from the ONE canonical voice-
# lint core at opeff main's read-only mirror, so changing the rule is one
# edit in opeff, with no per-repo sync. A missing or unreadable core refuses
# the commit rather than passing it with the gate silently gone.
_VOICE_LINT_CORE="$HOME/.local/agencyos/main/agencyos-operational-efficiency/hooks/voice-lint-core.sh"
if [ ! -r "$_VOICE_LINT_CORE" ]; then
  echo "pre-commit [opeff#1347 voice-lint-core]: the canonical core is missing or unreadable at $_VOICE_LINT_CORE. Refusing to pass a commit with the dash gate absent. The mirror is refreshed by launchd from opeff main; check it with refresh-main-mirror.sh --check." >&2
  exit 1
fi
bash -c '. "$1"' voice-lint-core "$_VOICE_LINT_CORE" || exit 1
_secrets=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '(^|/)(\.env|.*\.pem|.*_rsa|.*\.p12|id_ed25519)$' || true)
if [ -n "$_secrets" ]; then
  echo "pre-commit BLOCK: possible secret file(s) staged:"
  printf '%s\n' "$_secrets"
  echo "Bypass only if certain: git commit --no-verify"
  exit 1
fi
# Fleet block ends above, at fleet blob 14c9b4ec.
# opeff#1390 step 1: the repo-specific _R1#184 code-arm voice gate moved to
# .githooks/voice-lint-local.sh, verbatim, per Overwatch's ruling that a
# repo-specific gate lives there, not inline here. REQUIRED, not optional:
# opeff's own loader (hooks/voice-lint-pre-commit.sh) treats this file as
# optional and silently skips it when absent, which would have dropped the
# .ts/.tsx/.sh coverage _R1#184 added with no error at all. Run through sh
# explicitly, not sourced, so a freshly checked-out 644 copy still runs
# without needing scripts/install-hooks.sh's chmod first.
_hookdir="$(cd "$(dirname "$0")" && pwd)"
_VOICE_LINT_LOCAL="$_hookdir/voice-lint-local.sh"
if [ ! -r "$_VOICE_LINT_LOCAL" ]; then
  echo "pre-commit BLOCK: voice-lint-local.sh is missing or unreadable at $_VOICE_LINT_LOCAL. Refusing to pass a commit with the repo-specific voice gate absent." >&2
  echo "Bypass only if certain: git commit --no-verify" >&2
  exit 1
fi
sh "$_VOICE_LINT_LOCAL" || exit 1
