# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/public/nutrient-viewer/

# production
/build

# misc
.DS_Store
*.pem

# local database
local.db
runway-local.db

# Runway data
data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.worktrees
.mcp.json

# local scratch dir (per-worktree working files, not for the repo)
scripts/worktree-scratch/

# thought-partner local state (per-developer, not for the repo)
# Keep TP-STATE.md tracked (durable long-form state); ignore everything
# else (TP-HANDOFF.json, etc. — auto-managed by PreCompact hook).
.tp/*
!.tp/TP-STATE.md


# brain docs, reference docs, scratch/tmp docs, and inspiration sources (local working files)
docs/brain/
docs/reference/
docs/tmp/
/sources

# playwright visual-qa artifacts (never commit)
/playwright/.auth/
/playwright-report/
/test-results/
/screenshots/

# session pointer archives (per-session snapshots, not for the repo)
.claude/sessions/archive/
