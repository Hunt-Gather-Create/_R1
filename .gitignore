# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/public/nutrient-viewer/

# production
/build

# misc
.DS_Store
*.pem

# local database
local.db
runway-local.db

# Runway data
data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.worktrees
.mcp.json

# local scratch dir (per-worktree working files, not for the repo)
scripts/worktree-scratch/

# thought-partner local state (per-developer, not for the repo).
# Whole directory ignored — TP-STATE.md is per-developer too and lives
# locally only. Split into a shared canonical artifact tracked separately
# if the team needs it (see backlogged GH issue).
.tp/


# brain docs, reference docs, scratch/tmp docs, and inspiration sources (local working files)
docs/brain/
docs/reference/
docs/tmp/
/sources

# playwright visual-qa artifacts (never commit)
/playwright/.auth/
/playwright-report/
/test-results/
/screenshots/

# session pointer archives (per-session snapshots, not for the repo)
.claude/sessions/archive/

# ephemeral subagent worktrees (per-CC spawns, not for the repo)
.claude/worktrees/

# Claude Code harness lock files (per-session ephemeral)
.claude/*.lock

# GSD plugin auto-managed handoff pointer (per-developer state)
.planning/HANDOFF.json
.planning/STATE.md

# gstack tooling output (per-developer cache)
.gstack/

# Google service-account keys (never commit)
*.service-account.json
di-tp-exit-debrief.md

# DI-TP one-off diagnostics (data-integrity working files, never committed
# to runway per fleet rule). Scoped to 2026-06 ON PURPOSE: this glob has no
# tracked convention to collide with, unlike the migrations marker below.
scripts/diagnostics/*-2026-06-*

# DI-TP working migrations, _R1#168: a naming marker, not a date. A dated
# glob here expires every month and nothing notices, which is what #168
# happened on. Tracked migrations import MigrationContext from
# "../runway-migrate" like every other file in this directory and never
# carry this suffix, so the marker glob covers every DI-TP working script
# forever without swallowing the tracked convention it lives beside.
scripts/runway-migrations/*.di.ts

# Seat tool state, machine-local, never work (git SOP six-numbers bar, 2026-09-12)
.claude/.headroom_wrap_marker.json
.claude/.headroom_wrap_owners.json
.planning/.pending-auth-captures.jsonl
.serena/
