#!/bin/sh
# Local pre-push test run (_R1#107, part 1) plus the hygiene guard (_R1#167).
#
# THIS FILE, as a whole, IS NOT A GATE: it lives in .git, it is not cloned,
# and `git push --no-verify` walks straight past everything in it, hygiene
# guard included, since that flag operates at the git level, above this
# script. It protects only machines that ran the installer.
#
# The visible signal is .github/workflows/pr-tests.yml, which runs on the PR
# where everyone can see the result. Do not let anyone describe THIS file as
# the gate.
#
# And do not describe that one as a gate either, yet: the runway branch is
# unprotected and the check is not required, so it REPORTS and does not BLOCK.
# See docs/runway/test-gates.md.
#
# Two steps below, two different postures once you ARE running this file:
#
# 1. The hygiene guard has NO escape hatch of its own beyond --no-verify. It
#    runs first, before the RUNWAY_SKIP_PREPUSH check, and refuses on its own
#    exit code, never on output text. A documented skip flag is exactly how
#    the fleet's one prior tree-state check ended up enforcing nothing but a
#    warning. See scripts/hygiene-guard.sh.
#    The guard also reads the pre-push ref-update stream ("<local ref>
#    <local sha> <remote ref> <remote sha>", one line per ref being
#    pushed) from stdin, to catch a force-push orphaning a held object.
#    _R1#148 needs that same stream below, after the guard has already run,
#    to tell a delete-only push from a real one. Stdin can only be read
#    once, so it is captured to a temp file up front and fed to the guard
#    from that file, never left connected straight through as before.
# 2. The test-suite step below it DOES have a documented, deliberate skip:
#    RUNWAY_SKIP_PREPUSH=1. _R1#148 adds a second, narrower skip that is not
#    an escape hatch: when EVERY ref-update line says "delete" (local sha is
#    all zeros), there is no code in this push for the suite to have an
#    opinion about, so the suite step does not run. A push that deletes one
#    ref and updates another still runs the suite; only a push that deletes
#    everything and adds nothing skips it. The hygiene guard runs on a
#    delete-only push exactly as it does on any other push.
set -e

root=$(git rev-parse --show-toplevel)
echo "pre-push: checking for fossil state (merged branches/worktrees)."

# Capture the pre-push ref-update stream once, before anything reads stdin.
# The hygiene guard below expects this same stream on ITS stdin, so it is
# replayed from this file, byte for byte, rather than read twice from the
# original pipe (which would give the guard nothing on its second read).
stdin_file=$(mktemp) || {
  echo ""
  echo "pre-push: could not create a temp file to capture the pre-push ref-update stream."
  exit 1
}
trap 'rm -f "$stdin_file"' EXIT
if ! cat >"$stdin_file"; then
  echo ""
  echo "pre-push: could not read the pre-push ref-update stream from stdin."
  exit 1
fi

# _R1#171: origin is the fork in any repo that has one (_R1 itself), so a
# hardcoded "origin" below made the guard resolve trunk against the fork's
# stale branch and refuse every push. Two settings, both defaulting to
# today's behaviour so no other repo's pre-push changes: hygiene.remote
# (default "origin") and hygiene.trunk (default empty, meaning "resolve it
# from the remote's own HEAD", exactly as before this existed).
#
# `git config --get` exits 1 for "not set", indistinguishable from any other
# failure unless separated -- same contract hygiene-guard.sh already holds
# for merge-base at _resolve_trunk / _branch_governed. Read inside an `if`
# so `set -e` above does not abort this script on the ordinary "not set"
# exit 1. Anything else means the config read itself is broken, and that
# must refuse rather than silently fall back to "origin".
hygiene_remote=origin
if remote_cfg=$(git config --get hygiene.remote 2>/dev/null); then
  # Exit 0: set. An empty value is treated as unset, never passed through
  # (an empty hygiene.remote would otherwise reach hygiene-guard.sh as "").
  if [ -n "$remote_cfg" ]; then
    hygiene_remote="$remote_cfg"
  fi
else
  remote_cfg_status=$?
  if [ "$remote_cfg_status" -ne 1 ]; then
    echo ""
    echo "pre-push: HYGIENE GUARD REFUSED. 'git config --get hygiene.remote' failed with exit $remote_cfg_status, not the documented 'not set' exit of 1. Not defaulting to origin for an instrument failure."
    echo "pre-push: this guard has no skip flag of its own. git push --no-verify walks past it if you truly mean to."
    exit 1
  fi
fi

hygiene_trunk=""
if trunk_cfg=$(git config --get hygiene.trunk 2>/dev/null); then
  if [ -n "$trunk_cfg" ]; then
    hygiene_trunk="$trunk_cfg"
  fi
else
  trunk_cfg_status=$?
  if [ "$trunk_cfg_status" -ne 1 ]; then
    echo ""
    echo "pre-push: HYGIENE GUARD REFUSED. 'git config --get hygiene.trunk' failed with exit $trunk_cfg_status, not the documented 'not set' exit of 1. Not defaulting to HEAD-derived trunk resolution for an instrument failure."
    echo "pre-push: this guard has no skip flag of its own. git push --no-verify walks past it if you truly mean to."
    exit 1
  fi
fi

if ! sh "$root/scripts/hygiene-guard.sh" "$root" "$hygiene_remote" "" "" "$hygiene_trunk" <"$stdin_file"; then
  echo ""
  echo "pre-push: HYGIENE GUARD REFUSED. Push blocked."
  echo "pre-push: this guard has no skip flag of its own. git push --no-verify walks past it if you truly mean to."
  exit 1
fi

if [ "${RUNWAY_SKIP_PREPUSH:-}" = "1" ]; then
  echo "pre-push: test suite skipped (RUNWAY_SKIP_PREPUSH=1). The PR check still runs."
  exit 0
fi

# _R1#148: a delete-only push (every ref-update line's local sha is all
# zeros) pushes no code, so there is nothing for the suite to have an
# opinion about. A push is read from the captured stream, never from a
# branch name or any other proxy: any line whose local sha is NOT all
# zeros means at least one ref is being created or updated, and the suite
# runs. An empty stream (zero lines) is not "all deletes"; it never reaches
# git's pre-push invocation in practice, so it takes the ordinary path
# below and runs the suite rather than being read as vacuously true.
all_deletes=1
line_count=0
while IFS= read -r ref_line || [ -n "$ref_line" ]; do
  [ -z "$ref_line" ] && continue
  line_count=$((line_count + 1))
  local_sha=$(printf '%s\n' "$ref_line" | awk '{print $2}')
  case "$local_sha" in
    0000000000000000000000000000000000000000) ;;
    *) all_deletes=0 ;;
  esac
done <"$stdin_file"

if [ "$line_count" -gt 0 ] && [ "$all_deletes" -eq 1 ]; then
  echo "pre-push: delete-only push, test suite skipped. The PR check does not apply either: nothing was pushed."
  exit 0
fi

echo "pre-push: running the test suite. Skip with --no-verify if you mean to."

if ! pnpm test:run; then
  echo ""
  echo "pre-push: SUITE IS RED. Push refused."
  echo "pre-push: pushing anyway is a choice, not an accident: git push --no-verify"
  exit 1
fi

echo "pre-push: suite green."
